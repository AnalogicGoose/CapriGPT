{
  "name": "caprigpt",
  "version": "0.4.0",
  "description": "CapriGPT local-first Ollama desktop companion prototype, based on Capri",
  "author": "mochiiwuff",
  "repository": "github:mochiiwuff/capri-desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "demo": "node scripts/demo.js",
    "dist": "electron-builder --win",
    "test": "node --test tests/*.test.js",
    "test:desktop": "electron scripts/smoke-electron.js",
    "test:memory": "electron scripts/smoke-electron.js --memory-only",
    "test:release": "electron scripts/smoke-electron.js --release-only",
    "diagnose:reply": "node scripts/diagnose-reply.js",
    "codex:install": "node scripts/install-codex-hooks.js",
    "codex:uninstall": "node scripts/install-codex-hooks.js --uninstall",
    "codex:status": "node scripts/install-codex-hooks.js --status",
    "codex:check": "node scripts/check-codex-connection.js",
    "test:layout": "electron scripts/smoke-electron.js --layout-only",
    "test:agent": "electron scripts/smoke-electron.js --agent-only",
    "test:agent-live": "node scripts/smoke-agent-live.js",
    "test:settings": "electron scripts/smoke-electron.js --settings-only",
    "test:tasks": "electron scripts/smoke-electron.js --tasks-only",
    "test:tasks-live": "node scripts/smoke-tasks-live.js",
    "test:playback-live": "electron scripts/smoke-electron.js --playback-live",
    "test:tasks-ui-live": "electron scripts/smoke-electron.js --tasks-ui-live",
    "test:firefox-live": "electron scripts/smoke-electron.js --firefox-live",
    "test:chrome-live": "electron scripts/smoke-electron.js --chrome-context-live",
    "test:context-live": "node scripts/smoke-context-live.js",
    "test:conversation-live": "node scripts/check-conversation.js",
    "test:memory-language": "electron scripts/smoke-electron.js --memory-language-only",
    "test:memory-language-live": "node scripts/smoke-memory-language-live.js",
    "test:foreground-priority": "electron scripts/smoke-electron.js --foreground-priority"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "koffi": "3.3.4"
  },
  "build": {
    "appId": "caprigpt.desktop",
    "productName": "CapriGPT",
    "files": [
      "src/**",
      "assets/**",
      "hooks/**",
      "scripts/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "hooks/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/koffi-win32-*/**",
      "src/main/codex-events.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/capri.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "CapriGPT",
      "artifactName": "CapriGPT-Setup-${version}.${ext}"
    }
  }
}
